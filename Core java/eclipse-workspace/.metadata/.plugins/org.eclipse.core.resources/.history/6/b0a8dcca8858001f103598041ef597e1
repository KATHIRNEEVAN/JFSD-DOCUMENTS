package Assignments;
import java.util.*;
public class Dog {
    String DogName;
    String Breed;
    Dog(String DogName,String Breed){
    	this.DogName = DogName;
    	this.Breed = Breed;
    }
    void Display() {
    	System.out.println("Dog Name : "+DogName);
    	System.out.println("Dog Breed : "+Breed);
    }
	public static void main(String[] args) {
		Dog dog = new Dog("Subramani","German-shepard");
		dog.Display();
		

	}

}
