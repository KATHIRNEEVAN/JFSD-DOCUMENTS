package Assignments;
class Dog{
	void makesound() {
		System.out.println("Bark Bark ...");
	}
}
class Cat extends Dog{
	void makesound() {
		System.out.println("Meow Meow ...");
	}
}
public class Overrideclass {

	public static void main(String[] args) {
		Dog cat = new Cat();
		cat.makesound();

	}

}
