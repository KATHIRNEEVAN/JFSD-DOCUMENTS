package com.ksr;
class vehicle{
	void noofengine() {
		System.out.println("i have one vehicle");
	}
}
class Twowheeler extends vehicle{
	void noofwheels() {
		System.out.println("its a two wheeler ");
	}
}
class bike extends Twowheeler{
	void brandname(){
		System.out.println("brand is honda");
	}
	
}
public class SingleInherit {

