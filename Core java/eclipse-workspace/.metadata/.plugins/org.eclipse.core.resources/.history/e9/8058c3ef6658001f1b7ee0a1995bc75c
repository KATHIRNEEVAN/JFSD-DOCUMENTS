package com.ksr;

public class Myclass {
    int b =20;
    static int c =30;
	public static void main(String[] args) {
		int a = 10;
		System.out.println("local variable : "+a);
		Myclass obj =  new Myclass();
		System.out.println("object variable : "+obj.b);
		System.out.println("static variable : "+Myclass.c);

	}

}
